#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

// レイヤー番号は keymap ノード内の「記述順」で決まる(この #define の数値では
// ない)。順番を入れ替えるときは必ず下の keymap 内のノード順も同時に直すこと。

#define L_MAC       0
#define L_WIN       1
#define L_FUNCTION  2
#define L_NUM_MAC   3
#define L_NUM_WIN   4
#define L_ARROW     5
#define L_MOUSE     6
#define L_SCROLL    7
#define L_SETTING   8

&mt {
    // 変更点1: 高速タイピング時のCtrl/Shift誤爆対策。balanced→tap-preferred

    flavor = "tap-preferred";
    quick-tap-ms = <0>;
};

&trackball {
    // 変更点3: トラックボール誤タップ対策のため automouse-layer は廃止。
    // MOUSEレイヤーはSQTキーのホールドで手動発動する(下記各ベースレイヤー参照)。

    scroll-layers = <L_SCROLL>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,runtime-combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 10>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <9 8>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <20 21>;
        };

        // ベースレイヤー(L_MAC / L_WIN)は常時アクティブなので、MOUSE等が
        // 上に乗っている間もこの layers 判定で正しく振り分けられる。

        redo_mac {
            bindings = <&kp LG(LS(Z))>;
            key-positions = <22 23 24>;
            layers = <L_MAC>;
        };

        redo_win {
            bindings = <&kp LC(LS(Z))>;
            key-positions = <22 23 24>;
            layers = <L_WIN>;
        };

        // 右手だけでスクロール: マウス操作中(SQTホールド=MOUSE層)に L と ; を
        // 同時ホールドすると L_SCROLL が乗り、トラックボールがスクロールに化ける
        // (scroll-layers=<L_SCROLL>)。離すと即MOUSE層に戻る。L/; の単押しは
        // MB2/透過のまま(遅延ゼロ)。マウス層限定なので通常入力には影響しない。

        scroll_hold {
            bindings = <&mo L_SCROLL>;
            key-positions = <20 28>;
            layers = <L_MOUSE>;
            timeout-ms = <200>;
        };
    };

    macros {
        to_mac_default: to_mac_default {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to L_MAC &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_MAC_DEFAULT";
        };

        to_win_default: to_win_default {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to L_WIN &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_WIN_DEFAULT";
        };

        // BT profile -> base-layer routing. Key position fixed (H/J/K/L/SQT),
        // BT_SEL number fixed; only the &to base-layer differs (案B 2026-06-24).

        bt_h_win: bt_h_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &to L_WIN>;
            label = "BT_H_WIN";
        };

        bt_j_mac: bt_j_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to L_MAC>;
            label = "BT_J_MAC";
        };

        bt_k_win: bt_k_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to L_WIN>;
            label = "BT_K_WIN";
        };

        bt_l_ipad: bt_l_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to L_MAC>;
            label = "BT_L_IPAD";
        };

        bt_sqt_iphone: bt_sqt_iphone {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &to L_MAC>;
            label = "BT_SQT_IPHONE";
        };

        // 変更点4: _ \ | はUSキーコードの組み合わせではJIS誤認識状態で
        // 物理的に作れない(JIS配列側にしかない専用キーが必要なため)。
        // Windowsの「Alt+テンキーコード」Unicode直接入力機能で代替する。
        // 注意: ホストPCのNumLockがON、かつAltキーの押下/解放が正しく
        // 届く経路であることが前提(多段リモートデスクトップだと不安定な場合あり)。

        alt_underscore: alt_underscore {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0>,
                <&macro_tap>,
                <&kp KP_NUMBER_0>,
                <&macro_tap>,
                <&kp KP_NUMBER_9>,
                <&macro_tap>,
                <&kp KP_NUMBER_5>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_UNDERSCORE_WIN";
        };

        alt_backslash: alt_backslash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0>,
                <&macro_tap>,
                <&kp KP_NUMBER_0>,
                <&macro_tap>,
                <&kp KP_NUMBER_9>,
                <&macro_tap>,
                <&kp KP_NUMBER_2>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_BACKSLASH_WIN";
        };

        alt_pipe: alt_pipe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0>,
                <&macro_tap>,
                <&kp KP_NUMBER_1>,
                <&macro_tap>,
                <&kp KP_NUMBER_2>,
                <&macro_tap>,
                <&kp KP_NUMBER_4>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_PIPE_WIN";
        };
    };

    behaviors {
        rt_macro: rt_macro {
            compatible = "zmk,behavior-runtime-macro";
            #binding-cells = <1>;
        };

        lt_to_mac: lt_to_mac {
            compatible = "zmk,behavior-runtime-hold-tap";
            label = "LAYER_TAP_TO_MAC";
            bindings = <&mo>, <&to_mac_default>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lt_to_win: lt_to_win {
            compatible = "zmk,behavior-runtime-hold-tap";
            label = "LAYER_TAP_TO_WIN";
            bindings = <&mo>, <&to_win_default>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <50>;
        };

        encoder_vol_down_up: encoder_vol_down_up {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            label = "ENCODER_VOL_DOWN_UP";
            #sensor-binding-cells = <0>;
            cw-binding = <&kp C_VOLUME_DOWN>;
            ccw-binding = <&kp C_VOLUME_UP>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        MAC {
            bindings = <
&kp Q             &kp W      &kp E         &kp R                       &kp T                                                             &kp Y                 &kp U  &kp I      &kp O    &kp P
&kp A             &kp S      &kp D         &kp F                       &kp G                &kp K_MUTE                    &kp MINUS      &kp H                 &kp J  &kp K      &kp L    &lt L_MOUSE SQT
&mt LEFT_SHIFT Z  &kp X      &kp C         &kp V                       &kp B                &mo L_SETTING                 &kp SEMICOLON  &kp N                 &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LEFT_GUI      &kp LCTRL  &kp LEFT_ALT  &lt_to_mac L_SETTING LANG2  &lt L_NUM_MAC SPACE  &lt_to_mac L_ARROW LANG1      &kp BACKSPACE  &lt L_FUNCTION ENTER                             &kp DELETE
            >;

            sensor-bindings = <&encoder_vol_down_up>;
        };

        WIN {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                       &kp T                                                             &kp Y                 &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                       &kp G                &kp K_MUTE                    &kp MINUS      &kp H                 &kp J  &kp K      &kp L    &lt L_MOUSE SQT
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                       &kp B                &mo L_SETTING                 &kp SEMICOLON  &kp N                 &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_win L_SETTING LANG2  &lt L_NUM_WIN SPACE  &lt_to_win L_ARROW LANG1      &kp BACKSPACE  &lt L_FUNCTION ENTER                             &kp DELETE
            >;

            sensor-bindings = <&encoder_vol_down_up>;
        };

        FUNCTION {
            bindings = <
&none         &none         &none         &none         &none                               &none         &none         &none         &none         &none
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &none        &none    &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F11      &kp F12  &kp F6        &kp F7        &kp F8        &kp F9        &kp F10
&trans        &trans        &trans        &trans        &trans        &trans       &trans   &trans                                                  &none
            >;
        };

        NUM_MAC {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                                   &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL                    &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                      &trans           &trans           &trans           &trans        &trans                       &trans          &trans                                                                     &kp PIPE
            >;
        };

        // 変更点4: Windows直結時(JIS誤認識状態)でも記号が正しく出るよう
        // キーコードを補正したNUMレイヤー。WINレイヤーのSPACEのみここを参照する
        // (MACは通常のNUM_MACのまま)。
        // 数字・ピリオド・カンマ等、JISとUSで差が出ない部分はNUM_MACと共通。
        // _ \ | の3つはUSキーコードの組み合わせでは物理的に作れないため、
        // Alt+テンキーコードによるUnicode直接入力マクロで代替している。

        NUM_WIN {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                                   &kp EQUAL        &kp LS(NUMBER_6)  &kp LS(NUMBER_0)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp LS(SQT)  &kp LC(LA(KP_NUMBER_0))      &alt_underscore  &kp EXCLAMATION  &kp LBKT          &kp HASH          &kp DOLLAR        &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD   &kp LS(MINUS)                &trans           &kp RBKT         &kp BSLH          &kp LS(RBKT)      &kp LS(BSLH)      &alt_backslash
&trans                      &trans           &trans           &trans           &trans       &trans                       &trans           &trans                                                                 &alt_pipe
            >;
        };

        ARROW {
            bindings = <
&trans  &trans          &kp UP_ARROW    &trans           &trans                          &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &kp C_MUTE      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans          &trans           &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans          &trans           &trans  &trans          &trans  &trans                          &trans
            >;

            sensor-bindings = <&encoder_vol_down_up>;
        };

        // MOUSE層はMac用ショートカットに一本化(旧APPLE_MOUSEの条件付きレイヤーは廃止)。
        // 上段の LC(LEFT/RIGHT) はMacのデスクトップ切替、LG(TAB) はCmd+Tab。

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB5  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB4  &mkp MB1  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        // SCROLL層は scroll-layers=<L_SCROLL> の受け皿専用。キーは全て透過で、
        // 下のMOUSE層がそのまま効く。

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SETTING {
            bindings = <
&bt BT_CLR   &trans  &trans  &trans  &trans                      &trans     &trans     &trans     &trans      &studio_unlock
&trans       &trans  &trans  &trans  &trans  &trans      &trans  &bt_h_win  &bt_j_mac  &bt_k_win  &bt_l_ipad  &bt_sqt_iphone
&rt_macro 0  &trans  &trans  &trans  &trans  &trans      &trans  &to L_WIN  &to L_MAC  &trans     &trans      &trans
&trans       &trans  &trans  &trans  &trans  &trans      &trans  &trans                                       &trans
            >;
        };
    };
};
